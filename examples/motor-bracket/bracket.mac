! bracket.mac  ARG1 = global element size, ARG2 = local size at bolt holes + inner corner
! ARG3 = 1 static, 2 modal, ARG4 = motor rotary inertia (t*mm^2). Units: mm, N, MPa, tonne
! Usage: *USE,bracket.mac,2,1,1,1.0   (global 2 mm, 1 mm local, static, realistic inertia)
FINISH
/CLEAR,NOSTART
/PREP7
ES=ARG1
HL=ARG2
ATYP=ARG3
MI=ARG4                 ! motor rotary inertia, t*mm^2 (D80 mm motor ~ 1.0; 0 = point mass)
*IF,MI,LE,0,THEN
MI=1e-9
*ENDIF
BLOCK,0,80,0,6,0,40
BLOCK,0,6,6,60,0,40
VADD,ALL
WPROTA,0,-90,0
WPOFFS,0,0,-1
CYL4,20,-20,4.25,,,,8
CYL4,60,-20,4.25,,,,8
WPCSYS,-1,0
VSEL,S,VOLU,,1,2
CM,HOLES,VOLU
VSEL,ALL
VSEL,U,VOLU,,1,2
CM,BODY,VOLU
VSEL,ALL
VSBV,BODY,HOLES
ALLSEL
MP,EX,1,68900
MP,PRXY,1,0.33
MP,DENS,1,2.70e-9
ET,1,SOLID187
ESIZE,ES
MSHAPE,1,3D
! local refinement: hole bores (radius 4.25) and inner corner line (X=6,Y=6)
LOCAL,11,1,20,0,20,0,-90,0
LOCAL,12,1,60,0,20,0,-90,0
CSYS,11
ASEL,S,LOC,X,4.2,4.3
CSYS,12
ASEL,A,LOC,X,4.2,4.3
CSYS,0
AESIZE,ALL,HL
LSLA,S
LESIZE,ALL,HL,,,,,,,1
LSEL,S,LOC,X,5.99,6.01
LSEL,R,LOC,Y,5.99,6.01
LESIZE,ALL,HL,,,,,,,1
ALLSEL
VMESH,ALL
*GET,NN,NODE,0,COUNT
CSYS,11
NSEL,S,LOC,X,4.2,4.3
CM,HOLE1,NODE
CSYS,12
NSEL,S,LOC,X,4.2,4.3
CM,HOLE2,NODE
CSYS,0
CMSEL,S,HOLE1
CMSEL,A,HOLE2
D,ALL,ALL,0
ALLSEL
ET,2,MASS21
R,2,1.2e-3,1.2e-3,1.2e-3,MI,MI,MI    ! motor mass (t) and rotary inertia (t*mm^2)
*GET,NMAX,NODE,0,NUM,MAXD
PILOT=NMAX+1
N,PILOT,-30,50,20
TYPE,2
REAL,2
E,PILOT
NSEL,S,LOC,X,0
NSEL,R,LOC,Y,40,60
NSEL,R,LOC,Z,10,30
RBE3,PILOT,ALL,ALL
ALLSEL
TYPE,1
REAL,1
FINISH
*IF,ATYP,EQ,1,THEN
/SOLU
ANTYPE,STATIC
F,PILOT,FX,500
ACEL,0,9806.65,0
SOLVE
FINISH
/POST1
SET,LAST
ESEL,S,TYPE,,1
NSLE,S
NSORT,S,EQV
*GET,SVM,SORT,0,MAX
*GET,NVM,SORT,0,IMAX
*GET,SVMX,NODE,NVM,LOC,X
*GET,SVMY,NODE,NVM,LOC,Y
*GET,SVMZ,NODE,NVM,LOC,Z
NSORT,U,SUM
*GET,UMAX,SORT,0,MAX
! t/2 = 3 mm from sharp inner corner
ESEL,S,TYPE,,1
NSLE,S
NSEL,R,LOC,X,5.99,6.01
NSEL,R,LOC,Y,8.4,9.6
NSORT,S,EQV
*GET,SUP3,SORT,0,MAX
ESEL,S,TYPE,,1
NSLE,S
NSEL,R,LOC,Y,5.99,6.01
NSEL,R,LOC,X,8.4,9.6
NSORT,S,EQV
*GET,SBA3,SORT,0,MAX
! peak excluding corner box and 3 mm rings round both bores
ESEL,S,TYPE,,1
NSLE,S
NSEL,R,LOC,X,0,12
NSEL,R,LOC,Y,0,12
CM,CORN,NODE
ESEL,S,TYPE,,1
NSLE,S
CMSEL,U,CORN
CSYS,11
NSEL,U,LOC,X,0,7.25
CSYS,12
NSEL,U,LOC,X,0,7.25
CSYS,0
NSORT,S,EQV
*GET,SFAR,SORT,0,MAX
*GET,NFAR,SORT,0,IMAX
*GET,SFX,NODE,NFAR,LOC,X
*GET,SFY,NODE,NFAR,LOC,Y
*GET,SFZ,NODE,NFAR,LOC,Z
ALLSEL
*GET,UPX,NODE,PILOT,U,X
*GET,UPY,NODE,PILOT,U,Y
CMSEL,S,HOLE1
ESLN,S
SPOINT,,20,3,20
FSUM
*GET,R1X,FSUM,0,ITEM,FX
*GET,R1Y,FSUM,0,ITEM,FY
*GET,R1MZ,FSUM,0,ITEM,MZ
ALLSEL
CMSEL,S,HOLE2
ESLN,S
SPOINT,,60,3,20
FSUM
*GET,R2X,FSUM,0,ITEM,FX
*GET,R2Y,FSUM,0,ITEM,FY
*GET,R2MZ,FSUM,0,ITEM,MZ
ALLSEL
SPOINT,,0,0,0
*ELSE
/SOLU
ANTYPE,MODAL
MODOPT,LANB,6
MXPAND,6
SOLVE
*GET,F1,MODE,1,FREQ
*GET,F2,MODE,2,FREQ
*GET,F3,MODE,3,FREQ
*GET,F4,MODE,4,FREQ
*GET,F5,MODE,5,FREQ
*GET,F6,MODE,6,FREQ
FINISH
*ENDIF
